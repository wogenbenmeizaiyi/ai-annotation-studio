# Linux 单机部署使用的 Compose 环境模板。
# 推荐通过 scripts/server-local.sh 自动生成 .local/server.env，不要提交真实密码。

# 本机构建出的业务镜像标签。
BUSINESS_IMAGE_TAG=local

# 浏览器实际访问平台的完整 Origin（协议 + 主机/IP + 端口，不包含路径）。
PUBLIC_ORIGIN=http://localhost:7280
AUTH_ALLOWED_ORIGINS=http://localhost:7280,http://127.0.0.1:7280
AUTH_COOKIE_SECURE=false

# 浏览器能够访问的 MinIO API 地址，用于生成图片和模型的预签名 URL。
S3_PUBLIC_ENDPOINT=http://localhost:19000

# 对外端口。默认只公开 Web 和 MinIO 预签名对象地址。
WEB_PORT=7280
S3_PORT=19000
INFRA_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=15432
RABBITMQ_PORT=15673
RABBITMQ_MANAGEMENT_PORT=15674
REDIS_PORT=16379
MINIO_CONSOLE_PORT=19001

# 本地基础设施凭据。脚本首次运行时会生成随机值。
POSTGRES_USER=ai_studio
POSTGRES_PASSWORD=change_me
RABBITMQ_USER=ai_studio
RABBITMQ_PASSWORD=change_me
REDIS_PASSWORD=change_me
MINIO_USER=ai_studio
MINIO_PASSWORD=change_me

# 三个服务使用同一个 PostgreSQL 容器，但数据库必须相互独立。
ANNOTATION_POSTGRES_DB=annotation_studio
RECOGNITION_POSTGRES_DB=recognition_service
AUTH_POSTGRES_DB=auth_service

# 认证配置。Issuer、Audience 和 Redis DB 必须在三个后端保持一致。
AUTH_ISSUER=ai-annotation-studio-auth
AUTH_AUDIENCE=ai-annotation-studio
AUTH_REDIS_DB=3
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7

# 可选：Qwen/百炼能力。不填写不影响普通标注和基础识别功能。
AGENT_API_KEY=
AGENT_MODEL=qwen3.7-plus
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

# 匿名识别接口限制。
PUBLIC_SUBMIT_RATE=30
PUBLIC_DIRECT_RATE=10
PUBLIC_QUERY_RATE=120
PUBLIC_MAX_IMAGES=100
PUBLIC_MAX_UPLOAD_BYTES=20971520
PUBLIC_IMAGE_URL_ALLOWLIST=

# 识别队列。通常不需要修改。
RABBITMQ_QUEUE_NAME=tasks.image.disease_detection
RABBITMQ_RESULT_QUEUE=events.image.disease_detected
RABBITMQ_RESULT_EXCHANGE=events.image.disease_detected

# 资源检查。无 NVIDIA GPU 时，启动脚本会在当前命令中覆盖为 false。
RESOURCE_CHECK_ENABLED=true
RESOURCE_MIN_SYSTEM_MEMORY_MB=1024
RESOURCE_MIN_GPU_MEMORY_MB=2048
