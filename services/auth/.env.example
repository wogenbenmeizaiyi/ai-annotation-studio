# 运行环境：本地原生开发使用 development；正式 HTTPS 部署使用 production。
APP_ENV=development

# 认证服务自己的 PostgreSQL 数据库。
# 可以和另外两个服务使用同一个 PostgreSQL 实例，但 POSTGRES_DB 必须是独立数据库。
# 外部模式只自动创建表，不会创建 PostgreSQL 数据库本身。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=auth_service

# 保存登录限流、用户状态和会话撤销信息的 Redis。
# 标注和识别服务必须读取同一个 Redis 实例和同一个 REDIS_DB。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3

# JWT 签发者和受众。业务服务校验令牌时必须使用相同值。
# 使用根目录 dev.ps1 启动时会自动同步给标注和识别服务，通常不需要修改。
AUTH_ISSUER=ai-annotation-studio-auth
AUTH_AUDIENCE=ai-annotation-studio

# 非对称签名密钥。私钥只允许认证服务读取，两个业务服务只读取公钥。
# development 下首次启动会自动生成；production 下应预先生成并以只读文件挂载。
# 相对路径以 services/auth 为基准，dev.ps1 外部模式会转换为共享绝对路径。
AUTH_PRIVATE_KEY_PATH=.local/keys/auth-private.pem
AUTH_PUBLIC_KEY_PATH=.local/keys/auth-public.pem

# 本地 HTTP 必须为 false；正式 HTTPS 部署必须为 true。
# true 时浏览器只会通过 HTTPS 发送登录 Cookie。
AUTH_COOKIE_SECURE=false

# 允许哪些“前端网页来源”跨域携带登录 Cookie，格式为协议+主机+端口。
# 多个来源使用英文逗号分隔，不要填写 /api 路径，也不要使用 *。
# 这不是用户/IP 白名单；所有访问同一个前端地址的用户共用同一个 Origin。
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 短期访问令牌和刷新会话有效期。访问令牌到期后前端会自动刷新。
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
