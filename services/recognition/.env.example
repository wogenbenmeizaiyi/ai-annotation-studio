# ============================================
# RabbitMQ 消息队列配置
# ============================================

# 容器时区，用于日志时间
TZ=Asia/Shanghai

# RabbitMQ 服务器地址
RABBITMQ_HOST=172.16.0.72

# RabbitMQ 服务端口（默认：5672）
RABBITMQ_PORT=5672

# RabbitMQ 登录用户名（请联系管理员获取）
RABBITMQ_USER=your_rabbitmq_username

# RabbitMQ 登录密码（请联系管理员获取）
RABBITMQ_PASS=your_rabbitmq_password

# RabbitMQ 虚拟主机（默认：/）
RABBITMQ_VHOST=/

# RabbitMQ 队列名称
RABBITMQ_QUEUE=task_queue


# ============================================
# RabbitMQ 连接池高级配置（可选）
# ============================================

# 心跳间隔（秒），用于保持连接活跃
RABBITMQ_HEARTBEAT=600

# 连接阻塞超时时间（秒）
RABBITMQ_BLOCKED_CONNECTION_TIMEOUT=300

# 图像病害检测任务队列名称
RABBITMQ_QUEUE_NAME=tasks.image.disease_detection

# 图像病害检测任务死信交换机/队列
RABBITMQ_TASK_DLX=tasks.image.disease_detection.dlx
RABBITMQ_TASK_DLQ=tasks.image.disease_detection.dlq
RABBITMQ_TASK_DLQ_ROUTING_KEY=tasks.image.disease_detection.dlq

# 检测结果返回队列名称
RABBITMQ_RESULT_QUEUE=events.image.disease_detected

# 检测结果交换器名称
RABBITMQ_RESULT_EXCHANGE=events.image.disease_detected

# 检测结果死信交换机/队列
RABBITMQ_RESULT_DLX=events.image.disease_detected.dlx
RABBITMQ_RESULT_DLQ=events.image.disease_detected.dlq
RABBITMQ_RESULT_DLQ_ROUTING_KEY=events.image.disease_detected.dlq

# 回调失败后的重试间隔（秒）
CALLBACK_RETRY_INTERVAL_SECONDS=0

# 回调最多重试时长（秒）
CALLBACK_RETRY_TIMEOUT_SECONDS=10

# 单次回调HTTP请求超时（秒）
CALLBACK_REQUEST_TIMEOUT_SECONDS=10

# 回调最多尝试次数
CALLBACK_MAX_ATTEMPTS=1

# 单张图片识别失败后的最大尝试次数
IMAGE_RETRY_MAX_ATTEMPTS=3

# 单张图片识别失败后的重试间隔（秒）
IMAGE_RETRY_DELAY_SECONDS=30

# 检测结果每多少张图片批量入库一次
RESULT_DB_BATCH_SIZE=50

# 是否在每张图片识别前检查系统内存/GPU显存
RESOURCE_CHECK_ENABLED=true

# 资源不足时的检查间隔（秒）
RESOURCE_CHECK_INTERVAL_SECONDS=5

# 最小可用系统内存（MB）；低于该值则等待
RESOURCE_MIN_SYSTEM_MEMORY_MB=1024

# 最小可用GPU显存（MB）；低于该值则等待
RESOURCE_MIN_GPU_MEMORY_MB=2048

# 资源等待最大时长（秒）；0 表示一直等待
RESOURCE_WAIT_TIMEOUT_SECONDS=0

# 结果消费者并发数；回调重试阻塞时，其他任务仍可继续消费
RESULT_CONSUMER_CONCURRENCY=4

# 模型根目录；相对路径会按服务启动工作目录解析
MODELS_DIR=models
SAM_IMAGE_SIZE=1568
SAM_SEGMENTATION_EPSILON=4.0


# ============================================
# 多模态大模型 API 配置
# ============================================

# 通义千问 API Key（从阿里云控制台获取：https://dashscope.aliyun.com）
QWEN_API_KEY=your_qwen_api_key_here

# Kimi API Key（从 Moonshot AI 控制台获取：https://platform.moonshot.cn）
KIMI_API_KEY=your_kimi_api_key_here


# ============================================
# S3 对象存储配置（MinIO）
# ============================================

# S3/MinIO 服务端点地址
S3_ENDPOINT=http://172.16.0.110:9000

# S3 Access Key（请联系管理员获取或在 MinIO 控制台创建）
S3_ACCESS_KEY=your_s3_access_key

# S3 Secret Key（请联系管理员获取或在 MinIO 控制台创建）
S3_SECRET_KEY=your_s3_secret_key

# S3 区域（MinIO 默认：us-east-1）
S3_REGION=us-east-1

# S3 签名版本（MinIO 默认：s3v4）
S3_SIGNATURE_VERSION=s3v4


# ============================================
# Redis 缓存配置
# ============================================

# Redis 服务器地址
REDIS_HOST=172.16.0.110

# Redis 服务端口
REDIS_PORT=6380

# Redis 数据库编号（0-15）
REDIS_DB=12

# Redis 访问密码（如未设置可留空）
REDIS_PASSWORD=your_redis_password_or_leave_empty


# pg数据库配置
POSTGRES_HOST=172.16.0.110
POSTGRES_PORT=5433
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_postgres_database
