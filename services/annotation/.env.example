# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=annotation_local
POSTGRES_PASSWORD=change_me
POSTGRES_DB=annotation_studio_local

# S3 compatible storage
# 服务内部读写对象使用的地址。
S3_ENDPOINT=http://127.0.0.1:19000
# 可选：浏览器能够访问的对象地址。容器内 S3_ENDPOINT 使用 minio:9000 时必须单独设置。
S3_PUBLIC_ENDPOINT=http://127.0.0.1:19000
S3_ACCESS_KEY=annotation_local
S3_SECRET_KEY=change_me
S3_REGION=us-east-1
S3_SIGNATURE_VERSION=s3v4
S3_BUCKET_NAME=ai-cmm
S3_URL_EXPIRES=3600

# Local model and training paths
TRAIN_DATA_DIR=storage/train_data
YOLO_MODEL_DIR=models/yolo_models
SAM3_MODEL_PATH=models/sam3.pt
YOLO_WORKERS=4

# Optional training agent
AGENT_API_KEY=
AGENT_MODEL=qwen3.7-plus
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_TIMEOUT_SECONDS=180

# Authentication
# 下面参数用于验证认证服务签发的登录 Cookie，不用于连接认证数据库。
# 使用根目录 dev.ps1 启动时，会从 services/auth/.env 自动生成有效配置并覆盖这些示例值。
# 只有单独启动标注服务时，才需要手动保证公钥、Issuer、Audience 和 Redis 与认证服务一致。

# 认证服务生成的公钥。标注服务不需要、也不应该读取私钥。
AUTH_PUBLIC_KEY_PATH=.local/keys/auth-public.pem

# 必须与 services/auth/.env 中的 AUTH_ISSUER、AUTH_AUDIENCE 完全一致。
AUTH_ISSUER=ai-annotation-studio-auth
AUTH_AUDIENCE=ai-annotation-studio

# 认证状态 Redis，必须与认证服务使用同一个地址、密码和数据库编号。
# 如果配置错误，用户虽然能登录，但标注接口会返回 401。
AUTH_REDIS_HOST=localhost
AUTH_REDIS_PORT=6379
AUTH_REDIS_PASSWORD=
AUTH_REDIS_DB=3

# 允许访问标注平台接口的前端 Origin；不是平台用户白名单。
# 多个地址用英文逗号分隔，只写协议+主机+端口，不写接口路径。
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
