# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=annotation_local
POSTGRES_PASSWORD=change_me
POSTGRES_DB=annotation_studio_local

# S3 compatible storage
S3_ENDPOINT=http://127.0.0.1:19000
S3_ACCESS_KEY=annotation_local
S3_SECRET_KEY=change_me
S3_REGION=us-east-1
S3_SIGNATURE_VERSION=s3v4
S3_BUCKET_NAME=ai-cmm
S3_URL_EXPIRES=3600

# Local model and training paths
TRAIN_DATA_DIR=storage/train_data
YOLO_MODEL_DIR=models/yolo_models
SAM3_MODEL_PATH=models/sam3.pt
YOLO_WORKERS=4

# Optional training agent
AGENT_API_KEY=
AGENT_MODEL=qwen3.7-plus
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
