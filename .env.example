# AI Annotation Studio 连接配置汇总
#
# 这个文件只列出三个后端和前端需要连接的外部服务。
# 训练参数、限流、超时、资源阈值、模型路径等非连接配置使用代码中的默认值。
#
# 用于 GitLab 时，在 Settings -> CI/CD -> Variables 中逐项创建同名变量。
# 密码和 API Key 请设置为 Masked + Protected，不要把真实值提交到仓库。

# =============================================================================
# PostgreSQL
# =============================================================================

# 三个服务可以连接同一个 PostgreSQL 实例，但必须使用三个独立数据库。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

ANNOTATION_POSTGRES_DB=annotation_studio
RECOGNITION_POSTGRES_DB=recognition_service
AUTH_POSTGRES_DB=auth_service

# =============================================================================
# Redis
# =============================================================================

# 认证、标注和识别服务连接同一个 Redis。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 认证状态必须由三个后端共同使用同一个 DB。
AUTH_REDIS_DB=3

# =============================================================================
# RabbitMQ
# =============================================================================

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# =============================================================================
# S3 / MinIO
# =============================================================================

# 后端内部访问对象存储的地址。
S3_ENDPOINT=http://localhost:9000

# 浏览器能够访问的对象地址。本地可与 S3_ENDPOINT 相同；正式环境通常填写平台 HTTPS 地址。
S3_PUBLIC_ENDPOINT=http://localhost:9000

# 内置 MinIO 服务自己的管理员凭据。
MINIO_USER=
MINIO_PASSWORD=

# 标注和识别服务连接 S3 使用的凭据。
# 使用内置 MinIO 时，这两项分别填写与 MINIO_USER、MINIO_PASSWORD 相同的值。
S3_ACCESS_KEY=
S3_SECRET_KEY=

# =============================================================================
# Qwen / 百炼
# =============================================================================

# 标注服务训练 Agent 使用。
AGENT_API_KEY=
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 识别服务多模态能力使用。两个 Key 相同时也需要分别创建这两个变量。
QWEN_API_KEY=

# =============================================================================
# 认证与浏览器来源
# =============================================================================

# 多个前端 Origin 使用英文逗号分隔，不写 /api 路径，不使用 *。
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 本地 HTTP 使用 false；正式 HTTPS 使用 true。
AUTH_COOKIE_SECURE=false

# =============================================================================
# 前端 API 连接
# =============================================================================

# 生产环境使用相对路径，由 Nginx 转发到三个后端。
VITE_API_BASE_URL=/api/annotation
VITE_AI_SERVICE_BASE_URL=/api/ai
VITE_AUTH_SERVICE_BASE_URL=/api/auth

# 下面四项只用于 pnpm dev 的 Vite 本地代理。
VITE_ANNOTATION_PROXY_TARGET=http://127.0.0.1:8811
VITE_RECOGNITION_PROXY_TARGET=http://127.0.0.1:7987
VITE_AUTH_PROXY_TARGET=http://127.0.0.1:8787
VITE_SAM3_PROXY_TARGET=ws://127.0.0.1:8811
